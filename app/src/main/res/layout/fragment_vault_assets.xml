                            android:text="Prize Bonds (25 × PKR 40,000)"
                            android:textColor="@color/text_primary" android:textSize="15sp"
                            android:fontFamily="@font/montserrat_bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Investment · SBP Prize Bonds"
                            android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="2dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Kept in brown envelope, master bedroom safe"
                            android:textColor="@color/text_tertiary" android:textSize="11sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="end">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
