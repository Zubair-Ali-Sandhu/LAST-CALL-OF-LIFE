<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Event type + Severity row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sos_alert"
                app:tint="@color/accent_warning"
                android:contentDescription="@string/alert_icon_desc"/>

            <TextView
                android:id="@+id/tv_alert_event"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Weather Alert"
                android:textColor="@color/accent_warning"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/tv_alert_severity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_count_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Severe"
                android:textSize="11sp"
                android:fontFamily="@font/montserrat_bold"/>
        </LinearLayout>

        <!-- Headline -->
        <TextView
            android:id="@+id/tv_alert_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alert headline"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="@font/montserrat_bold"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="8dp"/>

        <!-- Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Area: "
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_alert_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Sender -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source: "
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_alert_sender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
