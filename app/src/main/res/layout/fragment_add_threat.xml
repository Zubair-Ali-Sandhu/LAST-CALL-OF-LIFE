<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/add_threat_title"
        app:titleTextColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding_h"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_2xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/add_threat_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:fontFamily="@font/montserrat_bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/threat_encrypted_note"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>

        <!-- Threat Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            style="@style/Widget.LastCall.TextInputLayout"
            android:hint="@string/threat_title_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_title"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="textCapSentences"
                android:textColor="@color/text_primary"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Detailed Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            style="@style/Widget.LastCall.TextInputLayout"
            android:hint="@string/detailed_description_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_description"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:textColor="@color/text_primary"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Threat Level Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_threat_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            style="@style/Widget.LastCall.ExposedDropdown"
            android:hint="@string/threat_level_hint">

            <AutoCompleteTextView
                android:id="@+id/sp_threat_level"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="none"
                android:textColor="@color/text_primary"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Known Individuals Involved -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_involved_persons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            style="@style/Widget.LastCall.TextInputLayout"
            android:hint="@string/known_individuals_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_involved_persons"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:textColor="@color/text_primary"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Locations to Avoid -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_locations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            style="@style/Widget.LastCall.TextInputLayout"
            android:hint="@string/locations_to_avoid_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_locations"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:textColor="@color/text_primary"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Incident Dates Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/incident_dates"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:fontFamily="@font/montserrat_bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_date"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="@string/add_date"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                app:backgroundTint="#181C35"
                app:strokeColor="#1F2545"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"/>
        </LinearLayout>

        <!-- Dates RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="16dp"/>

        <!-- Attach Evidence Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_attach_evidence"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:text="@string/attach_evidence"
            android:textSize="14sp"
            android:textColor="@color/accent_red"
            app:backgroundTint="#181C35"
            app:strokeColor="#FF2D5540"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_upload"
            app:iconTint="#FF2D55"/>

        <!-- Save Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/save_threat_entry"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"/>

    </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
