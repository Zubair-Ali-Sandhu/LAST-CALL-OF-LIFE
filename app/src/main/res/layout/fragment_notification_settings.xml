<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/notification_settings_title"
        app:titleTextColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="@dimen/page_padding_h" android:paddingTop="@dimen/spacing_md" android:paddingBottom="@dimen/spacing_2xl">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/checkin_timing" android:textColor="@color/text_secondary"
            android:textSize="10sp" android:letterSpacing="0.15"
            android:fontFamily="@font/montserrat_bold" android:layout_marginBottom="10dp"/>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp" app:strokeColor="@color/border_subtle" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="18dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/notify_contacts_on_checkin"
                        android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_notify_contacts_on_checkin"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:checked="true" style="@style/Widget.LastCall.Switch"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_subtle" android:layout_marginHorizontal="18dp"/>

                <LinearLayout android:id="@+id/pref_checkin_time"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_schedule" app:tint="@color/accent_red"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp"
                        android:text="@string/daily_checkin_time" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:id="@+id/sp_checkin_time"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/checkin_time_default" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_chevron_right" app:tint="#4A5070"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_subtle" android:layout_marginHorizontal="18dp"/>

                <LinearLayout android:id="@+id/pref_grace_period"
                    android:layout_width="match_parent" android:layout_height="60dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="18dp"
                    android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_timer" app:tint="@color/accent_warning"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp"
                        android:text="@string/grace_period" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:id="@+id/sp_grace_period"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/grace_period_default" android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_chevron_right" app:tint="#4A5070"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/alert_channels" android:textColor="@color/text_secondary"
            android:textSize="10sp" android:letterSpacing="0.15"
            android:fontFamily="@font/montserrat_bold" android:layout_marginBottom="10dp"/>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card" app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp" app:strokeColor="@color/border_subtle" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="4dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="18dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_notifications" app:tint="@color/accent_safe"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp"
                        android:text="@string/push_notifications" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_fcm_alerts" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true"
                        style="@style/Widget.LastCall.Switch"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_subtle" android:layout_marginHorizontal="18dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="18dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_sms_verify" app:tint="@color/accent_red"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp"
                        android:text="@string/sms_alerts" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_sms_alerts" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true"
                        style="@style/Widget.LastCall.Switch"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border_subtle" android:layout_marginHorizontal="18dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="18dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_schedule" app:tint="@color/accent_warning"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp"
                        android:text="@string/automated_phone_calls" android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/toggle_call_alerts" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="false"
                        style="@style/Widget.LastCall.Switch"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
