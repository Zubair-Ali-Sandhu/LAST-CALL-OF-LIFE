<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_primary"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/final_wishes_title"
        app:titleTextColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding_h"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/final_wishes_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/final_wishes_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="28dp"/>

            <!-- FUNERAL PREFERENCES SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/funeral_preferences"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="12dp"/>

            <!-- L9: RadioGroup — Funeral preference, only one can be selected -->
            <RadioGroup
                android:id="@+id/rg_funeral_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_dark"
                android:padding="14dp">

                <RadioButton
                    android:id="@+id/rb_traditional"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Traditional Burial"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent_red"
                    android:checked="true"
                    android:paddingStart="12dp"/>

                <RadioButton
                    android:id="@+id/rb_cremation"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Cremation"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent_red"
                    android:paddingStart="12dp"/>

                <RadioButton
                    android:id="@+id/rb_green"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Green / Natural Burial"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent_red"
                    android:paddingStart="12dp"/>

                <RadioButton
                    android:id="@+id/rb_donate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Donate to Science"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:buttonTint="@color/accent_red"
                    android:paddingStart="12dp"/>
            </RadioGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                style="@style/Widget.LastCall.TextInputLayout"
                android:hint="@string/funeral_instructions_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_funeral_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- LAST WISHES SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_wishes_header"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                style="@style/Widget.LastCall.TextInputLayout"
                android:hint="@string/last_wishes_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_last_wishes"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:textColor="@color/text_primary"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- PERSONAL MESSAGES SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/personal_messages_header"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:fontFamily="@font/montserrat_bold"/>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg">

                <!-- Message 1: To Sara -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_msg_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp"
                            android:src="@drawable/ic_avatar_placeholder" android:background="@drawable/shape_avatar_circle"
                            android:scaleType="centerCrop"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="To: Sara (Spouse)" android:textColor="@color/text_primary"
                                android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Thank you for everything. I love you always..."
                                android:textColor="@color/text_secondary" android:textSize="12sp"
                                android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right" app:tint="@color/text_tertiary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Message 2: To Ahmed -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_msg_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_subtle"
                    app:strokeWidth="1dp"
                    app:layout_constraintTop_toBottomOf="@id/card_msg_1">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp"
                            android:src="@drawable/ic_avatar_placeholder" android:background="@drawable/shape_avatar_circle"
                            android:scaleType="centerCrop"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="To: Ahmed (Brother)" android:textColor="@color/text_primary"
                                android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Take care of Ammi. The shop documents are in..."
                                android:textColor="@color/text_secondary" android:textSize="12sp"
                                android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end"/>
                        </LinearLayout>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right" app:tint="@color/text_tertiary"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Save Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_wishes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_button_primary"
                android:text="@string/save_final_wishes"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.08"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
