<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="28dp"
    android:gravity="center">

    <LinearLayout android:layout_width="72dp" android:layout_height="72dp"
        android:gravity="center" android:background="@drawable/bg_icon_circle"
        android:layout_marginBottom="20dp">
        <ImageView android:layout_width="36dp" android:layout_height="36dp"
            android:src="@drawable/ic_check_circle" app:tint="@color/accent_safe"/>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="Confirm Check-In"
        android:textColor="@color/text_primary" android:textSize="22sp"
        android:fontFamily="@font/montserrat_bold" android:layout_marginBottom="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center"
        android:text="This confirms you are safe and resets your 24-hour check-in timer. Your emergency contacts will be notified."
        android:textColor="@color/text_secondary" android:textSize="14sp"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginBottom="28dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent" android:layout_height="58dp"
        android:background="@drawable/bg_button_safe"
        android:text="YES, I'M ALIVE"
        android:textColor="@color/text_primary" android:textSize="15sp"
        android:fontFamily="@font/montserrat_bold" android:letterSpacing="0.08"
        android:stateListAnimator="@null"
        android:layout_marginBottom="10dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent" android:layout_height="50dp"
        android:text="Cancel" android:textColor="@color/text_secondary"
        app:backgroundTint="#00000000" app:cornerRadius="14dp"/>
</LinearLayout>
