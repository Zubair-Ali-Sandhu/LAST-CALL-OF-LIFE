                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PKR 2.1M" android:textColor="@color/accent_safe"
                        android:textSize="14sp" android:fontFamily="@font/montserrat_bold"/>
                </LinearLayout>
