<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_feed"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_primary"
        app:title="Safety Alerts"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.LastCall.CardTitle"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_feed_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_padding_h"
        android:layout_marginTop="@dimen/spacing_sm"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_subtle"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar_feed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_sos_alert"
                android:contentDescription="@string/alert_icon_desc"
                app:tint="@color/accent_warning"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Live safety alerts from the National Weather Service"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tv_alert_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_count_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="0"
                android:textColor="@color/accent_red"
                android:textSize="13sp"
                android:fontFamily="@font/montserrat_bold"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- RecyclerView for alerts -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_alerts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="@dimen/page_padding_h"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/card_feed_info"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        android:indeterminateTint="@color/accent_red"
        app:layout_constraintTop_toBottomOf="@id/card_feed_info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Error / Empty state -->
    <LinearLayout
        android:id="@+id/layout_error_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_2xl"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/card_feed_info"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_sos_alert"
            android:alpha="0.3"
            android:contentDescription="@string/alert_icon_desc"/>

        <TextView
            android:id="@+id/tv_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="No Alerts Available"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="@font/montserrat_bold"/>

        <TextView
            android:id="@+id/tv_error_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:paddingHorizontal="@dimen/page_padding_h"
            android:text="Check your internet connection and try again"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Retry"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/accent_red"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
