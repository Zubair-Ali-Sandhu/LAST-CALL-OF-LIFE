<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/iv_contact_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_avatar_placeholder"
            android:background="@drawable/shape_avatar_circle"
            android:scaleType="centerCrop"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_contact_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/contact_name"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat_bold"/>
            <TextView
                android:id="@+id/tv_access_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/emergency_vault_access_granted"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_access_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/read_only"
            android:textColor="@color/accent_warning"
            android:textSize="10sp"
            android:fontFamily="@font/montserrat_bold"
            app:chipBackgroundColor="#1AFFB800"
            app:chipMinHeight="26dp"
            app:chipStrokeColor="#FFB80040"
            app:chipStrokeWidth="1dp"
            app:chipCornerRadius="6dp"/>
    </LinearLayout>

    <!-- Session info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:background="@color/bg_primary"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_timer"
            app:tint="@color/accent_red"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tv_session_expiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/session_expires_in_23_45_00"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:text="@string/accessible_modules"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:letterSpacing="0.15"
        android:fontFamily="@font/montserrat_bold"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_accessible_modules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:nestedScrollingEnabled="false"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_revoke_access"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/revoke_access"
            android:textSize="13sp"
            android:textColor="@color/accent_red"
            app:backgroundTint="#1AFF2D55"
            app:strokeColor="#FF2D5540"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_done"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/done"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_bold"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
